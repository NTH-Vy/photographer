section.p-section-top-contact
  .l-container
    .p-section-top-contact__body
      .p-section-top-contact__information
        .p-section-top-contact__heading
          h2 Have a project or question in mind? Just send me a message.
          p Do you fancy saying hi to me or do you want to get started with your project and you need my help? Feel free to contact me. I will reply within 48 hours.

        ul.p-section-top-contact__detail
          li.p-section-top-contact__item
            figure.p-section-top-contact__icon
              img(src=path+"/img/top/contact_icn_phone_call.svg" alt="" width="24" height="24" loading="lazy")
            .p-section-top-contact__content
              span.p-section-top-contact__label Call me now
              a.p-section-top-contact__value(href="tel:+12025550190") +1-202-555-0190
          li.p-section-top-contact__item
            figure.p-section-top-contact__icon
              img(src=path+"/img/top/contact_icn_envelope.svg" alt="" width="24" height="24" loading="lazy")
            .p-section-top-contact__content
              span.p-section-top-contact__label Chat with me
              a.p-section-top-contact__value(href="mailto:kevin.gilbert@gmail.com") kevin.gilbert@gmail.com

        .p-section-top-contact__social
          p.p-section-top-contact__social-title
          .p-section-top-contact__social-list
            span.p-section-top-contact__social-line
            ul.p-section-top-contact__social-items
              li
                a.p-section-top-contact__social-link(href="#" aria-label="Facebook")
                  img(src="" alt="" width="20" height="20")
              li
                a.p-section-top-contact__social-link(href="#" aria-label="Twitter")
                  img(src="" alt="" width="20" height="20")
              li
                a.p-section-top-contact__social-link.is-active(href="#" aria-label="LinkedIn")
                  img(src="" alt="" width="20" height="20")
              li
                a.p-section-top-contact__social-link(href="#" aria-label="Instagram")
                  img(src="" alt="" width="20" height="20")
              li
                a.p-section-top-contact__social-link(href="#" aria-label="Dribbble")
                  img(src="" alt="" width="20" height="20")

      .p-section-top-contact__divider

      .p-section-top-contact__form-wrap
        h3.p-section-top-contact__form-title
          | Just say
          img(src="" alt="👋" width="24" height="24")
          |  Hi

        form.p-section-top-contact__form(action="#" method="post")
          .p-section-top-contact__form-row
            .p-section-top-contact__field
              input.p-section-top-contact__input(type="text" name="name" placeholder="Full Name" required)
            .p-section-top-contact__field
              input.p-section-top-contact__input(type="email" name="email" placeholder="Email Adress" required)

          .p-section-top-contact__field
            input.p-section-top-contact__input(type="text" name="subject" placeholder="Subject")

          .p-section-top-contact__form-row
            .p-section-top-contact__field.is-select
              select.p-section-top-contact__select(name="plan")
                option(value="" disabled selected) Pricing Plans
                option(value="basic") Basic Plan
                option(value="pro") Pro Plan
              span.p-section-top-contact__field-icon
                img(src="" alt="" width="16" height="16")

            .p-section-top-contact__field.is-date
              input.p-section-top-contact__input(type="text" name="date" placeholder="Date" onfocus="(this.type='date')" onblur="(this.type='text')")
              span.p-section-top-contact__field-icon
                img(src="" alt="" width="18" height="18")

          .p-section-top-contact__field
            textarea.p-section-top-contact__textarea(name="message" rows="5" placeholder="Message")

          button.p-section-top-contact__submit(type="submit")
            span Send Message
            img(src="" alt="" width="20" height="20")


