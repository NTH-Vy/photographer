              span Get in touch
            ul.p-section-top-about_social-link
              li.c-link.c-link--inline
                img(src=path+"/img/top/about_icn_facebook.svg" alt="Facebook" width="16" height="16" loading="lazy")
              li.c-link.c-link--inline
                img(src=path+"/img/top/about_icn_twitter.svg" alt="Twitter" width="16" height="16" loading="lazy")
              li.c-link.c-link--inline
                img(src=path+"/img/top/about_icn_linked.svg" alt="Linked" width="16" height="16" loading="lazy")
              li.c-link.c-link--inline
                img(src=path+"/img/top/about_icn_instagram.svg", alt="Instagram", width="16", height="16", loading="lazy")
              li.c-link.c-link--inline
                img(src=path+"/img/top/about_icn_unsplash.svg", alt="Unsplash", width="16", height="16", loading="lazy")

